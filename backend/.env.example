# 服务
HOST=127.0.0.1
PORT=8788
DEBUG=1

# 数据库（默认 SQLite，可切 PostgreSQL）
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/gb28181
DATABASE_URL=sqlite:///../data/analyzer.db

# 上传限制
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_TASKS=2

# 外部工具（留空则自动从 PATH / 常见路径查找）
TSHARK_PATH=
FFMPEG_PATH=

# 任务保留策略
# KEEP_TASKS=0 表示分析完立即清理原文件与视频
KEEP_TASKS=5
KEEP_DAYS=7
DISK_BUDGET_MB=2048

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
